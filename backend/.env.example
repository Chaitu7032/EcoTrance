NODE_ENV=development
PORT=5000

# Database — use one of the two options below.
# Option A: Supabase pooled connection string (recommended for cloud)
SUPABASE_DB_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true
SUPABASE_DB_SSL=true
# Option B: Standard local PostgreSQL (run via docker compose up -d postgres)
# DATABASE_URL=postgresql://ecotrace:ecotrace@localhost:5432/ecotrace
# SUPABASE_DB_SSL=false

# SerpApi — powers all 9 search engines (web, news, scholar, shopping, trends,
# ads transparency, patents, forums, youtube). Leave empty to use mock mode.
SERPAPI_KEY=YOUR_SERPAPI_KEY
SERPAPI_BASE_URL=https://serpapi.com/search.json
SERPAPI_MOCK_MODE=false

# LLM analysis engine (Groq-compatible endpoint)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
LLM_MAX_INPUT_PER_REQUEST=3500
LLM_MAX_SIMPLE_CALLS=3
LLM_MAX_DEEP_CALLS=4
LLM_TPM_LIMIT=8000

# Rate limiting and search budgets
AUDIT_MAX_REQUESTS=80
GLOBAL_MAX_REQUESTS=400
SIMPLE_AUDIT_MAX_SEARCHES=8
DEEP_AUDIT_MAX_SEARCHES=16
CACHE_TTL_HOURS=24
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info
